{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	// $app/tsconfig names no files. scripts/ is listed beside src/ because the
	// harnesses there -- the ones that prove the app actually runs -- are
	// typechecked and type-aware linted like the app itself; "*" is this
	// directory's own config files.
	"include": ["src", "scripts", "*"]
}
