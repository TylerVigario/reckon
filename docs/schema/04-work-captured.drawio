        <mxCell id="e41" value="visits" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#4a5468;fontColor=#4a5468;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="trip" target="trip_stop"><mxGeometry relative="1" as="geometry"/></mxCell>
