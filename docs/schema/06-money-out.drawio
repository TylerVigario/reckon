        <mxCell id="e60" value="is made of" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#4a5468;fontColor=#4a5468;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="invoice" target="invoice_line"><mxGeometry relative="1" as="geometry"/></mxCell>
