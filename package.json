{
	"name": "reckon",
	"version": "0.6.0",
	"description": "Invoicing and time tracking, self-hosted, for a small trade business.",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TylerVigario/reckon.git"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:schema": "node tests/schema-check.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:tz": "TZ=Pacific/Kiritimati vitest run src/lib/format.test.ts src/lib/timers.test.ts && TZ=Pacific/Midway vitest run src/lib/format.test.ts src/lib/timers.test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.mjs",
		"db:seed": "psql -q -v ON_ERROR_STOP=1 -f src/lib/server/db/seed/demo.sql",
		"db:test": "node scripts/db-test.mjs",
		"ci": "npm run format && npm run lint && npm run check && npm run test && npm run test:tz && npm run db:test && npm run build",
		"release": "node scripts/make-release.mjs"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/google.maps": "^3.66.5",
		"@types/node": "^24.13.4",
		"@types/pg": "^8.23.1",
		"@vts/commitlint-config": "github:TylerVigario/commitlint-config#semver:^0.3.0",
		"better-auth": "^1.7.7",
		"conventional-changelog-conventionalcommits": "^10.4.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"svelte-eslint-parser": "^1.8.1",
		"temporal-polyfill": "^1.0.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.2",
		"pg": "^8.23.1"
	},
	"overrides": {
		"better-auth": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
