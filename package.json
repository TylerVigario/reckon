{
	"name": "reckon",
	"version": "0.7.0",
	"description": "Invoicing and time tracking, self-hosted, for a small trade business.",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TylerVigario/reckon.git"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:schema": "node tests/schema-check.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:tz": "TZ=Pacific/Kiritimati vitest run src/lib/format.test.ts src/lib/timers.test.ts && TZ=Pacific/Midway vitest run src/lib/format.test.ts src/lib/timers.test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.mjs",
		"db:seed": "node scripts/seed.mjs",
		"db:test": "node scripts/db-test.mjs",
		"db:drift": "node scripts/db-drift.mjs",
		"ci": "npm run format && npm run lint && npm run check && npm run test && npm run test:tz && npm run db:drift && npm run db:test && npm run build",
		"release": "node scripts/make-release.mjs",
		"print": "sh third_party/press/tools/all.sh --tz UTC",
		"print:build": "sh third_party/press/tools/build.sh --tz UTC",
		"print:check": "sh third_party/press/tools/all.sh --check --tz UTC"
	},
	"devDependencies": {
		"@better-auth/core": "^1.7.18",
		"@better-auth/passkey": "^1.7.18",
		"@commitlint/cli": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@simplewebauthn/browser": "^13.3.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tylervigario/commitlint-config": "github:TylerVigario/commitlint-config#semver:^0.4.0",
		"@types/google.maps": "^3.66.9",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"better-auth": "^1.7.18",
		"conventional-changelog-conventionalcommits": "^10.4.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"fake-indexeddb": "^6.2.7",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"nodemailer": "^10.4.0",
		"pg": "^8.23.1",
		"pgpass": "^1.0.6",
		"pino": "^10.4.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.10.0",
		"temporal-polyfill": "^1.0.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"minimatch": "^11.0.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild": false
	}
}
