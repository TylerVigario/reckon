# Dependencies.
node_modules/

# Built: the application, SvelteKit's generated types, and press's renders.
/build/
/.svelte-kit/
print/

# Vite's scratch copies of its config.
vite.config.ts.timestamp-*

# Python bytecode from the diagram tooling.
__pycache__/
*.pyc

# An operator's own records, kept beside the code and never committed: notes,
# decisions, anything drawn from real clients. Listed here, not only in
# .git/info/exclude, because Prettier reads this file and not that one.
/private/

# The local environment, which may hold keys for development. Never committed:
# .env.example says what goes in it.
.env
.env.*
!.env.example

# What an operating system leaves behind.
.DS_Store
Thumbs.db
