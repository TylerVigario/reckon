{
	"dialect": "postgres",
	"includePattern": "public.*",
	"dateParser": "string",
	"numericParser": "string",
	"typeMapping": {
		"numeric": "NumericColumn"
	},
	"customImports": {
		"NumericColumn": "./numeric.ts",
		"TaxPiecesColumn": "./tax-pieces.ts"
	},
	"outFile": "./src/lib/server/db/database.ts",
	"overrides": {
		"columns": {
			"invoice_line.tax_pieces": "TaxPiecesColumn"
		}
	}
}
