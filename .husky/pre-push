# Branch naming, then CI's commit stage.
#
# Reads stdin per the git pre-push protocol: one line per ref, as
# `<local_ref> <local_sha> <remote_ref> <remote_sha>`. Only refs actually
# being pushed are checked, deletes are skipped, and main is skipped because
# the release workflow writes it.
#
# Bypass once with --no-verify. Not as a habit.

valid='^(feat|fix|refactor|perf|ci|build|docs|test|chore|revert)/[a-z0-9]+(-[a-z0-9]+)*$'

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  case "$remote_ref" in
    refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
    *) continue ;;
  esac
  [ "$branch" = "main" ] && continue

  if ! echo "$branch" | grep -Eq "$valid"; then
    echo "error: branch name '$branch' does not match the convention." >&2
    echo "" >&2
    echo "Expected: <type>/<slug>" >&2
    echo "  type: feat | fix | refactor | perf | ci | build | docs | test | chore | revert" >&2
    echo "  slug: kebab-case, single dashes, starts and ends with [a-z0-9]" >&2
    echo "" >&2
    echo "Rename: git branch -m <new-name>" >&2
    echo "Bypass once: git push --no-verify" >&2
    exit 1
  fi
done

# CI's commit stage: every check in .github/workflows/ci.yml that needs no
# running server or browser, by the jobs' own commands, and the guard suite
# beside them. A red check on a pull request should be news, not something this
# machine could have found first.
npm run ci
